# SmartMart AI — Backend Environment Configuration

# Database: Leave blank for local SQLite (supermarket.db), or paste your Supabase PostgreSQL connection URI.
# In Supabase: Project Settings -> Database -> Connection string -> URI (use Transaction Pooler port 6543)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Secret key required for destructive actions (reset, reload demo data, trigger model retrain)
SMARTMART_API_KEY=dev-key

# Allowed CORS Origins (comma-separated, or * for all)
# Example: https://your-project.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Optional: Google OAuth 2.0 Client ID for server-side token audience verification
GOOGLE_CLIENT_ID=
