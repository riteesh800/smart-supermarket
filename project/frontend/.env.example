# SmartMart AI — Frontend Environment Configuration

# Backend API Base URL
# Leave blank for local development (uses Vite proxy to http://localhost:8000)
# When deployed to Vercel, set this to your Render backend URL (e.g., https://your-backend.onrender.com/api)
VITE_API_BASE_URL=

# API Key matching SMARTMART_API_KEY on the backend
VITE_API_KEY=dev-key

# Optional: Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# If set, automatically enables official Google Identity Services (GIS) One-Tap and popup sign-in
VITE_GOOGLE_CLIENT_ID=
